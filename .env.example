# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# Keep it secret: anyone with it controls the bot.
DISCORD_TOKEN=

# Optional: your server's ID. Slash commands then appear in that server immediately;
# without it they register globally, which can take up to an hour the first time.
GUILD_ID=

# Optional: comma-separated role IDs whose members are never purged.
EXEMPT_ROLE_IDS=
